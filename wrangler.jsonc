{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insides-interior",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Phase 0: served from the free workers.dev address. The custom domain
  // (app.<domain>, SPEC 9.1) is added in a later phase.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://insides-interior.insides-interior.workers.dev",
    // Extra origins allowed to sign in (comma separated, * wildcards).
    "TRUSTED_ORIGINS": "",
    "BUSINESS_TIMEZONE": "Africa/Lagos",
    // Verified in Resend on 2026-10-30 (insidesinteriors.com, via Cloudflare DNS). Replies go to the business email.
    "EMAIL_FROM": "Insides Interior <hello@insidesinteriors.com>",
    // Web Push public key (public by design; the private key is the VAPID_PRIVATE_KEY secret).
    "VAPID_PUBLIC_KEY": "BH4wfm49vcTMz5QsazRlNU4IzkkIcLzL29pgvU6BWI58IxF8wOt6pctEIHXRzLbLcUQmFT8YTUR4OkwaIxoC0QY",
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed; the
  // full list with descriptions is in .dev.vars.example).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insides_db",
      "database_id": "ae9b4bd0-525d-4a48-b17f-c4159f159fe4",
      "migrations_dir": "app/server/db/migrations",
    },
  ],
  // R2 bucket and queue names only allow lowercase letters, digits and hyphens,
  // so SPEC's insides_files / insides_backups / insides_jobs use hyphens here.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "insides-files" },
    { "binding": "BACKUPS", "bucket_name": "insides-backups" },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "insides-jobs" }],
    "consumers": [{ "queue": "insides-jobs", "max_batch_size": 10, "max_retries": 5 }],
  },
  "browser": { "binding": "BROWSER" },
  // Portal routes: 30 requests a minute per IP (SPEC 11.1).
  "ratelimits": [
    { "name": "PORTAL_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "triggers": {
    // Africa/Lagos is UTC+1 all year (no DST): the daily job at 08:00 Lagos is
    // 07:00 UTC; the weekly digest Monday 07:30 Lagos is 06:30 UTC (SPEC 14.4
    // phase 8). features/automation CRON_JOBS maps each expression to its job.
    "crons": ["0 7 * * *", "30 6 * * 1"],
  },
  "env": {
    // PR previews (SPEC 13): a separate Worker with its own D1, R2 and queue,
    // seeded with fake data. Production data is never copied here.
    "preview": {
      "name": "insides-interior-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://insides-interior-preview.insides-interior.workers.dev",
        "TRUSTED_ORIGINS": "https://*-insides-interior-preview.insides-interior.workers.dev",
        "BUSINESS_TIMEZONE": "Africa/Lagos",
        "EMAIL_FROM": "Insides Interior <onboarding@resend.dev>",
        // Web Push public key (public by design; the private key is the VAPID_PRIVATE_KEY secret).
        "VAPID_PUBLIC_KEY": "BH4wfm49vcTMz5QsazRlNU4IzkkIcLzL29pgvU6BWI58IxF8wOt6pctEIHXRzLbLcUQmFT8YTUR4OkwaIxoC0QY",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "insides_db_preview",
          "database_id": "6ec99a8e-315a-4602-ad4e-17bfe583d8c8",
          "migrations_dir": "app/server/db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "insides-files-preview" },
        { "binding": "BACKUPS", "bucket_name": "insides-files-preview" },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "insides-jobs-preview" }],
        "consumers": [{ "queue": "insides-jobs-preview", "max_batch_size": 10, "max_retries": 5 }],
      },
      "browser": { "binding": "BROWSER" },
      "ratelimits": [
        { "name": "PORTAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
      ],
      "triggers": { "crons": [] },
    },
  },
}
