# Copy to .dev.vars for local development (never commit .dev.vars).
# This file also defines the secret names for `npm run typegen`.
# In production set each with `npx wrangler secret put <NAME>`.

APP_ENV=development
APP_URL=http://localhost:5173

# Signs sessions and tokens. Any long random string; production uses its own.
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Empty = dev email transport (emails, with their links, print in the terminal).
RESEND_API_KEY=

# Signing secret of the Resend webhook (whsec_...) for /api/webhooks/resend.
# Empty = the webhook answers 503.
RESEND_WEBHOOK_SECRET=

# Empty = the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enables /api/test/* sign-in helpers for Playwright. Never set in production.
E2E_SECRET=local-e2e-secret
